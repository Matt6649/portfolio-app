# Copy this file to .env and fill in your own values.

# ---- Ports ----
# Public portfolio site - safe to expose to the internet.
PUBLIC_PORT=8080
# Admin dashboard + API - by default docker-compose only binds this to
# 127.0.0.1 on the host, so it is NOT reachable from the public internet.
ADMIN_PORT=8081

# ---- Admin auth mode ----
# "passkey" (recommended) - WebAuthn/passkey login, no passwords stored.
# "basic"   - simple HTTP Basic Auth fallback if you don't want to deal
#             with WebAuthn origins/HTTPS at all.
AUTH_MODE=passkey

# ---- Passkey (WebAuthn) settings ----
# One-time secret required to register your FIRST passkey. Pick anything
# random, use it once in the admin setup screen, then you can forget it
# (or rotate it) - it is not needed for day-to-day logins.
SETUP_TOKEN=change-this-to-something-random

# Must match the hostname you use to ACCESS the admin dashboard in your
# browser, with no protocol/port. WebAuthn only works on:
#   - exactly "localhost", over plain HTTP, or
#   - a real domain name, over HTTPS.
# It will NOT work over a bare IP address or over HTTP on a non-localhost
# domain - that's a browser/WebAuthn restriction, not this app.
RP_ID=localhost
RP_NAME=My Portfolio Admin

# Full origin (protocol + host + port) exactly as typed in the browser
# address bar when you use the admin dashboard.
ORIGIN=http://localhost:8081

# Set to "true" only if the admin dashboard is served over HTTPS (e.g.
# behind a reverse proxy with a real certificate). Leave "false" for plain
# local HTTP access.
COOKIE_SECURE=false

# ---- Basic auth fallback (used when AUTH_MODE=basic, and optionally as
# an extra layer in front of passkey login too) ----
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change-this-too

# ---- Session ----
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Scanning ----
# How often (in minutes) sources are automatically re-scanned via their
# RSS feed for new articles. Set to 0 to disable automatic scanning
# (you can still trigger scans manually from the admin dashboard).
SCAN_INTERVAL_MINUTES=120
